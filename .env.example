# ===================================================
# YAKU-BACKEND CONFIGURATION (.env)
# Copia este archivo como .env y completa los valores
# ===================================================

# --- PostgreSQL Database ---
DB_URL=jdbc:postgresql://localhost:5432/yaku_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password

# --- JWT Authentication ---
# Clave secreta para firma de tokens (mínimo 256 bits / 32+ caracteres aleatorios)
JWT_SECRET=your_super_secret_jwt_signing_key_at_least_256_bits_long

# --- Stripe Payments ---
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_SUCCESS_URL=http://localhost:3000/payment-success
STRIPE_CANCEL_URL=http://localhost:3000/payment-cancel

# --- Firebase Admin SDK ---
# Ruta al archivo de credenciales de servicio Firebase (por ejemplo classpath:firebase-service-account.json)
FIREBASE_CONFIG_PATH=classpath:firebase-service-account.json

# --- MQTT Telemetry Broker ---
MQTT_ENABLED=false

# --- CORS Allowed Origins (separados por coma) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://front-opensource.web.app